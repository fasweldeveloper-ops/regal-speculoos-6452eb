
:root {
  font-family: Arial, Helvetica, sans-serif;
  color: #f4f6f5;
  background: #0c1511;
  font-synthesis: none;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  background: #0c1511;
}

button, a {
  font: inherit;
}

button {
  cursor: pointer;
}

.site {
  width: 100%;
  max-width: 850px;
  min-height: 100vh;
  margin: 0 auto;
  background: #0c1511;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 16px;
  background: #122019;
  border-bottom: 1px solid #29372e;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: white;
  text-decoration: none;
}

.brand-ball {
  font-size: 35px;
}

.brand strong {
  display: block;
  color: #79ed9b;
  font-size: 19px;
  letter-spacing: 1px;
}

.brand small {
  display: block;
  margin-top: 4px;
  color: #9aaa9f;
  font-size: 9px;
  letter-spacing: 2px;
}

.language {
  padding: 9px 12px;
  color: #8df2a9;
  background: #23372a;
  border: 1px solid #45684e;
  border-radius: 9px;
}

.nav {
  display: flex;
  justify-content: space-around;
  padding: 10px 5px;
  background: #17251c;
}

.nav-link {
  padding: 10px 13px;
  color: #aab8ae;
  background: transparent;
  border: 0;
  border-radius: 7px;
  font-size: 13px;
}

.nav-link.active {
  color: #092111;
  background: #83efa0;
  font-weight: bold;
}

.hero {
  padding: 40px 22px;
  background:
    radial-gradient(ellipse at top right, #284e32, transparent 65%),
    linear-gradient(145deg, #182d20, #0e1812);
  border-bottom: 1px solid #304735;
}

.hero-label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #90f0a6;
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 2px;
}

.live-dot {
  width: 8px;
  height: 8px;
  background: #80f39c;
  border-radius: 50%;
}

.hero h1 {
  max-width: 530px;
  margin: 20px 0 14px;
  font-size: clamp(30px, 8vw, 47px);
  line-height: 1.13;
}

.hero p {
  max-width: 450px;
  color: #bdcbbf;
  font-size: 15px;
  line-height: 1.7;
}

.primary-button {
  margin-top: 15px;
  padding: 13px 18px;
  color: #092111;
  background: #83efa0;
  border: 0;
  border-radius: 8px;
  font-weight: bold;
}

.section {
  padding: 28px 16px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.eyebrow {
  color: #82e99b;
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 1.5px;
}

.section h2 {
  margin: 8px 0 0;
  font-size: 22px;
}

.text-button {
  color: #8bed9f;
  background: transparent;
  border: 0;
  font-size: 12px;
}

.match-card {
  display: block;
  width: 100%;
  margin: 13px 0;
  padding: 16px;
  color: #f4f6f5;
  text-align: left;
  background: #17231b;
  border: 1px solid #2b4030;
  border-radius: 12px;
}

.match-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  color: #a7b7aa;
  font-size: 9px;
  font-weight: bold;
  letter-spacing: .5px;
}

.finished {
  color: #b8c6bb;
}

.upcoming {
  color: #f3cd72;
}

.teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 8px;
  margin: 24px 0;
}

.team {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
  text-align: center;
}

.team strong {
  font-size: 13px;
  overflow-wrap: anywhere;
}

.team-ball {
  font-size: 26px;
}

.away {
  text-align: center;
}

.score {
  padding: 9px;
  color: #8df2a5;
  background: #0c1710;
  border-radius: 8px;
  font-size: 21px;
  font-weight: bold;
}

.match-bottom {
  padding-top: 12px;
  color: #91dba1;
  border-top: 1px solid #2b3a2e;
  font-size: 11px;
}

.demo-note {
  color: #8e9d92;
  font-size: 11px;
  line-height: 1.6;
}

.commentary-section {
  padding: 30px 20px;
  text-align: center;
  background: linear-gradient(145deg, #1b3021, #132018);
  border-top: 1px solid #304735;
  border-bottom: 1px solid #304735;
}

.commentary-icon {
  margin-bottom: 14px;
  font-size: 38px;
}

.commentary-section h2 {
  margin: 12px 0;
  font-size: 25px;
}

.commentary-section p {
  color: #bdcbbf;
  font-size: 14px;
  line-height: 1.7;
}

.quote {
  margin: 22px 0 12px;
  padding: 18px;
  color: #d9f9df;
  background: #0b1710;
  border-left: 3px solid #83efa0;
  border-radius: 7px;
  font-size: 15px;
  line-height: 1.7;
}

.commentary-section small {
  color: #9aaa9f;
  font-size: 10px;
}

.news-card {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin: 14px 0;
  padding: 17px;
  background: #17231b;
  border: 1px solid #2b4030;
  border-radius: 11px;
}

.news-icon {
  font-size: 28px;
}

.news-card h3 {
  margin: 9px 0;
  font-size: 16px;
}

.news-card p {
  margin: 0;
  color: #b3c0b6;
  font-size: 13px;
  line-height: 1.7;
}

.page-section > h1 {
  margin-top: 12px;
  font-size: 30px;
}

.muted {
  color: #b3c0b6;
  font-size: 14px;
  line-height: 1.7;
}

.commentary-box {
  padding: 18px;
  background: #1c3022;
  border: 1px solid #3a5b40;
  border-radius: 10px;
  line-height: 1.8;
}

.commentary-box h3 {
  color: #91efa5;
}

.footer {
  padding: 28px 16px;
  text-align: center;
  background: #101a13;
  border-top: 1px solid #29372e;
}

.footer-brand {
  color: #83efa0;
  font-size: 18px;
  font-weight: bold;
}

.footer p {
  color: #bdcbbf;
  font-size: 13px;
}

.footer small {
  color: #829187;
  font-size: 10px;
}

@media (min-width: 600px) {
  .hero {
    padding: 60px 35px;
  }

  .section {
    padding: 35px;
  }
}
